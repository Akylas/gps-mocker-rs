{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "msi",
      "deb"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/settings_apk-debug.apk": "settings_apk-debug.apk"
    },
    "externalBin": [],
    "copyright": "© 2021 Akylas",
    "category": "DeveloperTool",
    "shortDescription": "",
    "longDescription": "",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "localhost",
      "signingIdentity": "Apple Development: Martin Guillon (4ZZRPWM525)",
      "entitlements": null
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../build",
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:3011"
  },
  "productName": "GPS Mocker",
  "mainBinaryName": "GPS Mocker",
  "identifier": "com.akylas.gpsmocker",
  "plugins": {},
  "app": {
    "security": {
      "csp": "default-src blob: data: filesystem: ws: wss: http: https: tauri: 'unsafe-eval' 'unsafe-inline' 'self' img-src: 'self'; worker-src blob:; connect-src ipc: http://ipc.localhost"
    }
  }
}
